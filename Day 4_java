//--------------------------------------------------------Number Decrease-------------------------------------------------------------------
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        for (int row = n; row >= 1; row--) {
            for (int col = n; col >= n - row + 1; col--) {
                System.out.print(col + " ");
            }
            System.out.println();
        }
    }
}
