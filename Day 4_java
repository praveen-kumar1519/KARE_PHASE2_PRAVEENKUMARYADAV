//------------------------------------------------------------odd to even-----------------------------------------------------------------------
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int row,col,c;
        for (row = 0; row < n; row++) {
            if(row % 2 == 0)
            c=1;
            else
            c=2;
            for (col = 0; col <= row; col++) {
                System.out.print(c+" ");
                c+=2;
            }
            System.out.println();
        }
    }
}
