//-------------------------------------------------square star----------------------------------------------------------
import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int row,col;
        for(row=0;row<n;row++,System.out.println())
        {
            for(col=0;col<n;col++)
            {
                if(row == 0 || row == n - 1 || col == 0 || col == n - 1)
                System.out.print("*");
                else
                System.out.print(" ");
            }
        }
    }
}
//-------------------------------------------------Number oredr-----------------------------------------------------------------
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        for (int row = 0; row < n; row++) {
            for (int col = 0; col < n; col++) {

                if ((row + col) % 2 == 0)
                    System.out.print("1");
                else
                    System.out.print("0");
            }
            System.out.println();
        }
    }
}
//--------------------------------------------------E Pattern--------------------------------------------
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int row,col;
        for (row = 0; row < n; row++) {
            for (col = 0; col < n; col++) {

                if (row == 0 || row == n / 2 || row == n - 1 || col == 0)
                    System.out.print("E");
                else
                    System.out.print(" ");

            }
            System.out.println();
        }
    }
}
//----------------------------------------------------N Patten---------------------------------------
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int row,col;
        for (row = 0; row < n; row++,System.out.println()) {
            for (col = 0; col < n; col++) {
                if (col == 0 || col == n - 1 || row == col)
                    System.out.print("N");
                else
                    System.out.print(" ");

            }
        }
    }
}
//-----------------------------------------------------M Pattern--------------------------------------------------------
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int row, col;

        for (row = 0; row < n; row++, System.out.println()) {
            for (col = 0; col < n; col++) {

                if (col == 0 || col == n - 1 || (row == col && row <= n / 2) || (row + col == n - 1 && row <= n / 2))
                    System.out.print("M");
                else
                    System.out.print(" ");
            }
        }
    }
}
